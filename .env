# Liga a camada de mocks (MSW + Socket.IO simulado). Obrigatório na demonstração.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (o MSW intercepta esse prefixo).
VITE_API_BASE_URL=/api
# Origem do servidor Socket.IO. Vazio = mesma origem da página.
VITE_SOCKET_URL=
# Timeout das requisições HTTP em milissegundos.
VITE_HTTP_TIMEOUT_MS=8000
